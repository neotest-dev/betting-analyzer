# ==========================================
# Configuración del Servidor Web (Flask)
# ==========================================

# Archivo de entrada de la aplicación Flask
FLASK_APP=app.py

# Entorno de ejecución (development | production)
FLASK_ENV=development

# Modo depurador (1 = activado, 0 = desactivado)
FLASK_DEBUG=1

# Puerto en el que se ejecuta el servidor web local
PORT=5000

# Clave secreta para la seguridad de sesiones y cookies
SECRET_KEY=betting-analyzer-super-secret-local-key-2026

# ==========================================
# Modo de Datos del Proveedor (DEMO o API)
# ==========================================

# Modo de proveedor: DEMO (datos mock locales en JSON) o API (consultas reales a OddsPapi)
PROVIDER_MODE=DEMO

# ==========================================
# Base de Datos (SQLite)
# ==========================================

# Ruta relativa del archivo de base de datos SQLite para historial y cuotas
DATABASE_PATH=betting_analyzer.db

# ==========================================
# Credenciales API Externa (OddsPapi)
# ==========================================

# Tu API Key de OddsPapi (obtener en https://oddspapi.io)
EXTERNAL_API_KEY=your_api_key_here

# URL base de la API de OddsPapi (v4)
EXTERNAL_API_URL=https://api.oddspapi.io/v4

# ==========================================
# Configuración del Proveedor OddsPapi
# ==========================================

# ID del deporte a analizar (10 = Fútbol)
ODDSPAPI_SPORT_ID=10

# Idioma de respuesta de la API para nombres de equipos y torneos (es, en, etc.)
ODDSPAPI_LANGUAGE=es

# Formato de las cuotas devueltas (decimal, american, fraction)
ODDSPAPI_ODDS_FORMAT=decimal

# Casas de apuestas a consultar separadas por comas (ej. pinnacle,betano.pe,apuestatotal,inkabet,betsson,bet365,1xbet)
ODDSPAPI_BOOKMAKERS=pinnacle,betano.pe,apuestatotal,inkabet,betsson,bet365,1xbet

# Activar filtrado estricto por torneos específicos (1 = activado, 0 = desactivado/todos los torneos)
ODDSPAPI_USE_TOURNAMENTS=1

# IDs de torneos/ligas a consultar separados por comas (ej. 7=Champions League, 17=Premier League, 8=LaLiga, etc.)
ODDSPAPI_TOURNAMENT_IDS=7,17,8,23,35,34,406,384,480

# Ventana de días futuros a consultar partidos (1 a 7 días)
ODDSPAPI_FIXTURE_DAYS=3

# Límite máximo de partidos a traer por petición para optimizar el consumo de la cuota de API
ODDSPAPI_MAX_FIXTURES=15

